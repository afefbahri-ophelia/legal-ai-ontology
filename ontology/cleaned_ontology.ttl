        "date"@en .

<registryKeeper> rdfs:label "حافظ الملكية العقارية"@ar,
        "Registry Keeper"@en .

<AcceptedRegistrationRequest> rdfs:label "طلب ترسيم مقبول"@ar,
        "Accepted Registration Request"@en .

<Contract> rdfs:label "Contract"@ar,
        "Contract"@en .

<LandTitle> rdfs:label "سند الملكية العقارية"@ar,
        "Land Title"@en .

