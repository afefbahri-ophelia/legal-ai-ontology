<RealEstateTransaction> rdfs:label "المعاملة العقارية"@ar,
        "Real Estate Transaction"@en .

<ReceiptDailyLog> rdfs:label "سجل اليومي للاستلام"@ar,
        "Receipt Daily Log"@en ;
