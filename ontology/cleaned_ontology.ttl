        "Reviewer"@en .

<SignatureAuthority> rdfs:label "سلطة الإمضاء"@ar,
        "Signature Authority"@en .

<WaiveOfRightCertificate> rdfs:label "شهادة في رفع اليد"@ar,
        "Waive of Right Certificate"@en .

