    default1:domain default1:DailyLogState ;
    default1:range default1:dateTime ;
    default1:type default1:DatatypeProperty ;
    rdfs:domain default1:DailyLogState,
        default1:LegalDocument ;
    rdfs:range xsd:dateTime .

default1:hasType a owl:ObjectProperty ;
    rdfs:label "له نوع"@ar,
        "has type"@en .

default1:hasVerificationStage a owl:ObjectProperty ;
    rdfs:label "له مرحلة تحقيق"@ar,
