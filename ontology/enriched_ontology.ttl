@prefix : <http://example.org#> .
@prefix default1: <http://example.org/land-registry#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ApplicationDispatch :type :Class .

:ApprovalOfOrderDailyLog :type :Class .

:ClosedDailyLog :subClassOf :DailyLogState ;
    :type :Class .

:ClosureOfReceiptDailyLog :type :Class .

:ClosureOfRegistrationDailyLog :type :Class .

:CompletelyClosed :subClassOf :DailyLogState ;
    :type :Class .

:ExaminerRecord :type :Class .

:FinalClosureOfRegistrationDailyLog :type :Class .

:LandTitleCopy :type :Class .

:OrderDailyLog :subClassOf :DailyLogState ;
    :type :Class .

:OwnershipCertificate :type :Class .

:ReceiptDailyLog :subClassOf :DailyLogState ;
    :type :Class .

:ReviewerRecord :type :Class .

:ServiceApplication :type :Class .

:UnderReview :subClassOf :RegistrationDailyLog ;
    :type :Class .

:assignedToExaminer :domain :RegistrationApplication ;
    :range :Examiner ;
    :type :ObjectProperty .

:assignedToReviewer :domain :RegistrationApplication ;
    :range :Reviewer ;
    :type :ObjectProperty .

:assignedToValidator :domain :RegistrationApplication ;
    :range :Validator ;
    :type :ObjectProperty .

:composedOf :domain :LandTitle ;
    :range :RealEstateTransaction ;
    :type :ObjectProperty .

:coreComponentOf :domain :RegistrationRecord ;
    :range :RegistrationDailyLog ;
    :type :ObjectProperty .

:hasDate :domain :RegistryDailyLog ;
    :range :dateTime ;
    :type :DatatypeProperty .

:hasEndTime :domain :DailyLogState ;
    :range :dateTime ;
    :type :DatatypeProperty .

:hasRegistrationRecord :domain :Validator ;
    :range :RegistrationRecord ;
    :type :ObjectProperty .

:hasStartTime :domain :DailyLogState ;
    :range :dateTime ;
    :type :DatatypeProperty .

:resultsFrom :domain :RealEstateTransaction ;
    :range :RegistrationRecord ;
    :type :ObjectProperty .

:stateOf :domain :DailyLogState ;
    :range :RegistryDailyLog ;
    :type :ObjectProperty .

default1:AdministrativeBody a owl:Class ;
    rdfs:label "الهيئة الإدارية"@ar,
        "Administrative Body"@en .

default1:AdministrativeDocument a owl:Class ;
    rdfs:label "الوثيقة الإدارية"@ar,
        "Administrative Document"@en ;
    rdfs:subClassOf default1:OfficialDocument .

default1:ApplicationDispatch a owl:Class ;
    rdfs:label "طلب الخدمة"@ar,
        "Application Dispatch"@en ;
    default1:hasDocumentVerification default1:DocumentVerification ;
    default1:hasRecordStamping default1:RecordStamping ;
    default1:hasRegistrationDetails default1:RegistrationDetails ;
    rdfs:comment "البيانات الواجب التحقق منها في مطلب الخدمة قبل ختم اليومية"@ar .

default1:ApprovalDecisionOnDivision a owl:Class ;
    rdfs:label "قرار مصادقة على تقسيم"@ar,
        "Approval Decision On Division"@en .

default1:CertificateOfPropertyTypeCange a owl:Class ;
    rdfs:label "شهادة في تغيير صبغة عقار"@ar,
        "Certificate of Property Type Change"@en .

default1:Certificates a owl:Class ;
    rdfs:label "الشهائد"@ar,
        "Certificates"@en .

default1:ClosedDailyLog a owl:Class ;
    rdfs:label "سجل يومي مغلق"@ar,
        "Closed Daily Log"@en ;
    default1:subClassOf default1:DailyLogState ;
    default1:type default1:Class ;
    rdfs:subClassOf default1:DailyLogState .

default1:ClosureOfReceiptDailyLog a owl:Class ;
    rdfs:label "ختم يومية الرهون"@ar,
        "Closure of Receipt Daily Log"@en ;
    default1:hasLandRegistrationContractDetails default1:LandRegistrationContractDetails ;
    rdfs:comment "الخطوات المتبعة لختم يومية الرهون في السجل العقاري"@ar .

default1:CompletelyClosed a owl:Class ;
    rdfs:subClassOf default1:DailyLogState .

default1:CourtClerkDocument a owl:Class ;
    rdfs:label "وثيقة مساعد القضاء"@ar,
        "Court Clerk Document"@en ;
    rdfs:subClassOf default1:OfficialDocument .

default1:CourtStampedDocument a owl:Class ;
    rdfs:label "الوثيقة المختومة بختم المحكمة"@ar,
        "Court Stamped Document"@en ;
    rdfs:subClassOf default1:JudicialDocument .

default1:DistributionOfRegistrationLogBooks a owl:Class ;
    rdfs:label "توزيع مدوّنات الترسيم"@ar,
        "Distribution of Registration Log Books"@en ;
    default1:hasType default1:Extractions,
        default1:Mortgages,
        default1:NormalOperations ;
    rdfs:comment "The different types of log books that are distributed to the regional director or his representative after the review of the registration requests is completed."@ar .

default1:EngineeringPlans a owl:Class ;
    rdfs:label "الأمثلة الهندسية الناقلة للملكية"@ar,
        "Engineering Plans"@en .

default1:ExaminerRecord a owl:Class ;
    rdfs:label "سجل الفاحص"@ar,
        "Examiner Record"@en .

default1:FinalClosureOfRegistrationDailyLog a owl:Class ;
    rdfs:label "ختم اليومية الختامي للترسيم"@ar,
        "Final Closure of Registration Daily Log"@en ;
    default1:hasType default1:Mortgages ;
    rdfs:comment "The final step in the daily registration process where the registration daily log is officially closed."@ar .

default1:IdentifySignatures a owl:ObjectProperty ;
    rdfs:label "التعريف بالإمضاءات"@ar,
        "Identify Signatures"@en ;
    rdfs:domain default1:AuthorizedParty ;
    rdfs:range default1:ContractingParty .

default1:JudicialBody a owl:Class ;
    rdfs:label "الهيئة القضائية"@ar,
        "Judicial Body"@en .

default1:JudicialOfficer a owl:Class ;
    rdfs:label "مساعد القضاء"@ar,
        "Judicial Officer"@en .

default1:LandRegistrationContract a owl:Class ;
    rdfs:label "عقد تسجيل الأراضي"@ar,
        "Land Registration Contract"@en .

default1:LandSurveyDocument a owl:Class ;
    rdfs:label "وثيقة ديوان قيس الأراضي"@ar,
        "Land Survey Document"@en ;
    rdfs:subClassOf default1:OfficialDocument .

default1:LandSurveyOffice a owl:Class ;
    rdfs:label "ديوان قيس الأراضي والمسح العقاري"@ar,
        "Land Survey Office"@en .

default1:LegalizedDocument a owl:Class ;
    rdfs:label "الوثيقة المصادق عليها"@ar,
        "Legalized Document"@en ;
    rdfs:comment "الوثائق الصادرة عن السلط الأجنبية التي تخضع لإجراء المصادقة أو الأبوستي" .

default1:LogDistributionToRegionalDirector a owl:ObjectProperty ;
    rdfs:label "توزيع المدونات على المدير الجهوي"@ar,
        "Distribution of Logs to Regional Director"@en ;
    rdfs:domain default1:DailyLogDistribution ;
    rdfs:range default1:RegionalDirector .

default1:ManagesReceiptDailyLog a owl:ObjectProperty ;
    rdfs:label "يتولى إجراءات يومية الرهون"@ar,
        "Manages Receipt Daily Log"@en ;
    rdfs:domain default1:RegionalDirector ;
    rdfs:range default1:ReceiptDailyLog .

default1:OfficialAdministrativeAuthority a owl:Class ;
    rdfs:label "الهيئة الإدارية الرسمية"@ar,
        "Official Administrative Authority"@en .

default1:OfficialStampAndSignature a owl:ObjectProperty ;
    rdfs:label "الختم والإمضاء الرسمي"@ar,
        "Official Stamp and Signature"@en ;
    default1:domain default1:OfficialIdentificationDocument ;
    default1:range default1:RegistrationAuthority .

default1:PropertyRegistrationDocument a owl:Class ;
    rdfs:label "وثائق ترسيم العقارات"@ar,
        "Property Registration Documents"@en ;
    default1:hasOfficialStatus true ;
    default1:issuedBy default1:AdministrativeAuthority .

default1:Protocols a owl:Class ;
    rdfs:label "المحاضر"@ar,
        "Protocols"@en .

default1:RegistrationDailyLogVerification a owl:Class ;
    rdfs:label "تحقيق في يومية الرهون"@ar,
        "Registration Daily Log Verification"@en ;
    rdfs:comment "المراحل التي يتم خلالها المصادقة على ختم يومية الرهون" .

default1:RegistrationOperation a owl:Class ;
    rdfs:label "نوع العملية"@ar,
        "Type of Operation"@en ;
    rdfs:comment "الأنواع المختلفة للعمليات التي يتم المصادقة عليها عند ختم يومية الرهون"@ar ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty default1:approveRegistrationDailyLog ;
            owl:someValuesFrom default1:ClosureOfRegistrationDailyLog ] .

default1:RequestToRegisterExpropriation a owl:Class ;
    rdfs:label "مطلب في ترسيم أمر إنتزاع"@ar,
        "Request to Register Expropriation"@en .

default1:ReviewerRecord default1:hasOfficialDocument default1:OfficialDocument .

default1:ServiceApplicationVerification a owl:Class ;
    rdfs:label "Service Application Verification"@ar,
        "Service Application Verification"@en ;
    rdfs:comment "التحقق من البيانات المطلوبة عند دراسة مطلب الخدمة (ServiceApplication) المقدم للترسيم"@ar .

default1:SignatureReadingReport a owl:Class ;
    rdfs:label "محضر تلاوة التوقيع"@ar,
        "Signature Reading Report"@en ;
    rdfs:comment "محضر التلاوة يجب أن يكون مطابقا للنموذج الملحق بمنشور السيد الوزير الأول عدد 33 المؤرخ في 16 جوان 1995" .

default1:SignatureVerification a owl:Class,
        owl:ObjectProperty ;
    rdfs:label "التثبت من صبغة الإمضاء"@ar,
        "التحقق من صبغة الإمضاء"@ar,
        "تحقق التوقيع"@ar,
        "Signature Verification"@en ;
    default1:domain default1:RealEstateRegistration ;
    default1:range default1:OfficialDocument ;
    rdfs:comment "الشروط القانونية التي يجب استيفاؤها عند تلاوة نص الكتب على الشخص المعني بالإمضاء" .

default1:StampingOfDailyLogOfMortgages a owl:ObjectProperty ;
    rdfs:label "ختم يومية الرهون"@ar,
        "Stamping of Daily Log of Mortgages"@en ;
    rdfs:domain default1:ApprovalOfOrderDailyLog ;
    rdfs:range default1:DailyLogDistribution .

default1:UnderReview a owl:Class ;
    rdfs:label "تحت المراجعة"@ar,
        "قيد المراجعة"@ar,
        "Under Review"@en ;
    rdfs:subClassOf default1:RegistrationDailyLog .

default1:VerifyApostilleStamp a owl:ObjectProperty ;
    rdfs:label "التحقق من ختم الأبوستي"@ar,
        "Verify Apostille Stamp"@en ;
    rdfs:domain default1:ApostilleStamp ;
    rdfs:range default1:RealEstateTransaction .

default1:VerifyOfficialStatus a owl:ObjectProperty ;
    rdfs:label "التثبت من الصبغة الرسمية"@ar,
        "Verify Official Status"@en ;
    rdfs:domain default1:Examiner ;
    rdfs:range default1:OfficialDocument .

default1:VerifyOwnership a owl:Class ;
    rdfs:label "التأكد من ملكية المتعامل"@ar,
        "Verify Ownership"@en ;
    default1:composedOf default1:LandRegistration ;
    rdfs:comment "الحالات التي يجب فيها التأكد من ملكية المتعامل لجميع العقار قبل الترسيم في السجل العقاري"@ar .

default1:assignedToExaminer a owl:ObjectProperty ;
    rdfs:label "مسند إلى المحقق"@ar,
        "Assigned to Examiner"@en ;
    default1:domain default1:ApostilleVerification,
        default1:RegistrationApplication ;
    default1:range default1:Examiner .

default1:assignedToReviewer a owl:ObjectProperty ;
    rdfs:label "تم إسناده إلى المراجع"@ar,
        "تم تعيينه للمراجع"@ar,
        "تم تكليفه للمراجعة"@ar,
        "Assigned To Reviewer"@en,
        "Assigned to Reviewer"@en,
        "assigned to Reviewer"@en,
        "assigned to reviewer"@en ;
    default1:domain default1:RegistrationApplication ;
    default1:range default1:Reviewer ;
    rdfs:domain default1:RegistrationApplication ;
    rdfs:range default1:Reviewer .

default1:assignedToValidator a owl:ObjectProperty ;
    rdfs:label "مسند إلى المصادق"@ar,
        "assigned to Validator"@en ;
    default1:domain default1:RegistrationApplication ;
    default1:range default1:Validator .

default1:authenticatesOwnershipCertificate a owl:ObjectProperty ;
    rdfs:label "يصادق على شهادة الملكية"@ar,
        "authenticates Ownership Certificate"@en ;
    rdfs:domain default1:AdministrativeAuthority,
        default1:JudicialAuthority ;
    rdfs:range default1:OwnershipCertificate .

default1:authorizedBy a owl:ObjectProperty ;
    rdfs:label "مفوض من قبل"@ar,
        "Authorized By"@en ;
    rdfs:domain default1:AuthorizedParty ;
    rdfs:range default1:registryKeeper .

default1:cancelledBasedOnClearanceDocument a owl:ObjectProperty ;
    rdfs:label "تم التشطيب عليه استنادًا إلى شهادة رفع اليد"@ar,
        "cancelled based on Clearance Document"@en .

default1:composedOf a owl:ObjectProperty ;
    rdfs:label "مكون من"@ar,
        "يتكون من"@ar,
        "composed of"@en ;
    rdfs:domain default1:LandTitle ;
    rdfs:range default1:PartiallyDividedRealEstate,
        default1:RealEstateTransaction .

default1:coreComponentOf a owl:ObjectProperty ;
    rdfs:label "جزء أساسي من"@ar,
        "core component of"@en ;
    default1:domain default1:RegistrationRecord ;
    default1:range default1:RegistrationDailyLog ;
    rdfs:range default1:RegistrationDailyLog .

default1:deputize a owl:ObjectProperty ;
    rdfs:label "ينوب عن"@ar,
        "deputizes"@en ;
    rdfs:domain default1:RegionalDirector ;
    rdfs:range default1:RegionalDirector .

default1:distributeLogsByFolders a owl:ObjectProperty ;
    rdfs:label "توزيع المدوّنات حسب المجلدات"@ar,
        "Distribute Logs by Folders"@en ;
    rdfs:domain default1:DailyLogDistribution ;
    rdfs:range default1:LogFolder .

default1:forwardAcceptedFiles a owl:ObjectProperty ;
    rdfs:label "إحالة الملفات المقبولة"@ar,
        "Forward Accepted Files"@en .

default1:handleRegistrationRequest a owl:ObjectProperty ;
    rdfs:label "يتولى معالجة طلب الترسيم"@ar,
        "Handles Registration Request"@en,
        "handles Registration Request"@en ;
    rdfs:domain default1:DailyLogState,
        default1:ReceiptDailyLog,
        default1:RegionalDirector ;
    rdfs:range default1:AcceptedRegistrationRequest,
        default1:RegistrationRequest,
        default1:RejectedRegistrationRequest .

default1:handleRegistrationRequests a owl:ObjectProperty ;
    rdfs:label "يتعامل مع طلبات الترسيم"@ar,
        "handles Registration Requests"@en ;
    rdfs:domain default1:RegionalDirector ;
    rdfs:range default1:AcceptedRegistrationRequest,
        default1:RejectedRegistrationRequest .

default1:hasApplicant a owl:ObjectProperty ;
    rdfs:label "لديه مقدم الطلب"@ar,
        "has Applicant"@en .

default1:hasApplication a owl:ObjectProperty ;
    rdfs:label "له طلب"@ar,
        "has Application"@en ;
    rdfs:domain default1:RegistrationDailyLog .

